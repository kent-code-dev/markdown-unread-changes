{
  "name": "markdown-unread-changes",
  "displayName": "Markdown Unread Changes",
  "description": "Markdown ファイルの、前回読んだときからの変更箇所を、VS Code 標準の Markdown プレビューで色付けします。インターネットには一切接続しません。",
  "version": "0.0.1",
  "publisher": "kent-code-dev",
  "icon": "media/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "diff",
    "changes",
    "unread"
  ],
  "type": "module",
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "制限モードでは、フォルダ側の設定（include・exclude・maxFiles・maxFileSize・openUnreadFileIn、files.exclude）を無視し、ユーザー設定と初期値で動作します。",
      "restrictedConfigurations": [
        "markdownUnreadChanges.include",
        "markdownUnreadChanges.exclude",
        "markdownUnreadChanges.maxFiles",
        "markdownUnreadChanges.maxFileSize",
        "markdownUnreadChanges.openUnreadFileIn"
      ]
    }
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/preview.css"
    ],
    "markdown.previewScripts": [
      "./media/preview.js"
    ],
    "commands": [
      {
        "command": "markdownUnreadChanges.markAsRead",
        "title": "表示中のファイルを既読にする",
        "category": "Markdown Unread Changes"
      },
      {
        "command": "markdownUnreadChanges.markAllAsRead",
        "title": "すべてのファイルを既読にする",
        "category": "Markdown Unread Changes"
      },
      {
        "command": "markdownUnreadChanges.showUnreadFiles",
        "title": "未読のファイルの一覧を表示する",
        "category": "Markdown Unread Changes"
      }
    ],
    "configuration": {
      "title": "Markdown Unread Changes",
      "properties": {
        "markdownUnreadChanges.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.md"
          ],
          "markdownDescription": "追跡する Markdown ファイルの glob パターン（ワークスペースのフォルダからの相対パス）。"
        },
        "markdownUnreadChanges.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/out/**",
            "**/build/**",
            "**/vendor/**"
          ],
          "markdownDescription": "追跡から除外するファイルの glob パターン。`#files.exclude#` に指定したものも除外します。"
        },
        "markdownUnreadChanges.maxFiles": {
          "type": "number",
          "default": 2000,
          "minimum": 1,
          "markdownDescription": "追跡するファイル数の上限。超えた場合は、開いたファイルだけを追跡します。"
        },
        "markdownUnreadChanges.maxFileSize": {
          "type": "number",
          "default": 1024,
          "minimum": 1,
          "markdownDescription": "これより大きいファイル（KB 単位）は追跡しません。"
        },
        "markdownUnreadChanges.openUnreadFileIn": {
          "type": "string",
          "enum": [
            "preview",
            "editor"
          ],
          "enumDescriptions": [
            "Markdown プレビューで開きます（変更箇所の色が見えます）。そのファイルのプレビューがすでに開いていれば、前面に出します。",
            "テキストエディタで開きます。"
          ],
          "default": "preview",
          "markdownDescription": "未読のファイルの一覧で選んだファイルを開く場所。"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import ./test/setup/register.mjs --test \"test/**/*.test.mts\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:deps",
    "check:deps": "npm ls --omit=dev --all",
    "package": "vsce package --allow-missing-repository",
    "vscode:prepublish": "npm run check && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "markdown-it": "^14.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
